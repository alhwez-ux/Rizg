APP_NAME=Rizg Liquidity Tracker
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://rizg.vercel.app"]
QUOTE_HISTORY_LIMIT=1000
WS_HEARTBEAT_SECONDS=20
ENABLE_MOCK_FEED=true
MOCK_FEED_INTERVAL_SECONDS=0.5
SCREENER_LEADER_LIMIT=10
SIGNAL_NET_FLOW_THRESHOLD=15000
SIGNAL_AGGRESSIVE_RATIO=0.58
SIGNAL_ATR_TARGET_MULT=1.5
SIGNAL_ATR_STOP_MULT=1.0
ALERT_WINDOW_SECONDS=60
ALERT_INFLOW_THRESHOLD=25000
ALERT_VOLUME_THRESHOLD=8000
ALERT_NET_FLOW_THRESHOLD=15000
ALERT_COOLDOWN_SECONDS=20
ALERT_HISTORY_LIMIT=50
TELEGRAM_ENABLED=false
# Create a bot via @BotFather, copy the token, then get your numeric Chat ID
# (message the bot and open https://api.telegram.org/bot<token>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_INTERVAL_MINUTES=30
TELEGRAM_REPORT_SYMBOLS=["4030"]
# Interval summaries still use TELEGRAM_ENABLED + TELEGRAM_REPORT_SYMBOLS.
# Instant radar/trap alerts use TelegramAlertBot as soon as the engine fires.
SAHM_API_KEY=
SAHMK_API_KEY=
SAHM_API_BASE_URL=https://api.sahmcapital.com/v1
SAHMK_DATA_MODE=delayed
SAHMK_POLL_SECONDS=30
SAHMK_WATCHLIST_POLL_SECONDS=20
SAHMK_MARKET_SCAN_SECONDS=90
SAHMK_BATCH_SIZE=4
SAHMK_REQUEST_GAP_SECONDS=0.4
SAHMK_CACHE_TTL_SECONDS=180
SAHMK_SYMBOLS=["4030"]
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_system_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password
ALERT_RECIPIENT_EMAIL=alhwez@gmail.com
FINANCIAL_SYNC_ENABLED=true
FINANCIAL_SYNC_HOUR=17
FINANCIAL_SYNC_MINUTE=0
FINANCIAL_SYNC_RUN_ON_STARTUP=true
