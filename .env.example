APP_NAME=Rizg Liquidity Tracker
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://rizg.vercel.app"]
QUOTE_HISTORY_LIMIT=1000
WS_HEARTBEAT_SECONDS=20
ENABLE_MOCK_FEED=true
MOCK_FEED_INTERVAL_SECONDS=0.5
SCREENER_LEADER_LIMIT=10
SIGNAL_NET_FLOW_THRESHOLD=15000
SIGNAL_AGGRESSIVE_RATIO=0.58
SIGNAL_ATR_TARGET_MULT=1.5
SIGNAL_ATR_STOP_MULT=1.0
ALERT_WINDOW_SECONDS=60
ALERT_INFLOW_THRESHOLD=25000
ALERT_VOLUME_THRESHOLD=8000
ALERT_NET_FLOW_THRESHOLD=15000
ALERT_COOLDOWN_SECONDS=20
ALERT_HISTORY_LIMIT=50
TELEGRAM_ENABLED=false
# Create a bot via @BotFather, copy the token, then get your numeric Chat ID
# (message the bot and open https://api.telegram.org/bot<token>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_REPORT_INTERVAL_MINUTES=30
TELEGRAM_REPORT_SYMBOLS=["4030"]
# Interval summaries still use TELEGRAM_ENABLED + TELEGRAM_REPORT_SYMBOLS.
# Instant radar/trap alerts use TelegramAlertBot as soon as the engine fires.
SAHM_API_KEY=
SAHMK_API_KEY=
# SAHMK keys (shmk_…) use api.sahmk.sa. Rizg retries api.sahmcapital.com/v1 on HTTP 404.
SAHM_API_BASE_URL=https://api.sahmk.sa/api/v1
SAHMK_DATA_MODE=delayed
SAHMK_POLL_SECONDS=30
SAHMK_WATCHLIST_POLL_SECONDS=20
SAHMK_MARKET_SCAN_SECONDS=90
SAHMK_BATCH_SIZE=4
SAHMK_REQUEST_GAP_SECONDS=0.4
SAHMK_CACHE_TTL_SECONDS=180
SAHMK_SYMBOLS=["4030"]
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_system_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password
ALERT_RECIPIENT_EMAIL=alhwez@gmail.com
FINANCIAL_SYNC_ENABLED=false
FINANCIAL_SYNC_HOUR=17
FINANCIAL_SYNC_MINUTE=0
FINANCIAL_SYNC_RUN_ON_STARTUP=false
# TASI session scheduler (Asia/Riyadh): 09:30 open, every 2m 10:00-15:00, 15:30 close
TASI_SCHEDULER_ENABLED=true
TASI_SCAN_INTERVAL_MINUTES=2
TASI_SCAN_LIMIT=12
# Tadawul/Sahm nightly pull is off — live prices come from TickChart only
TADAWUL_DAILY_SYNC_ENABLED=false
TADAWUL_DAILY_SYNC_HOUR=16
TADAWUL_DAILY_SYNC_MINUTE=0
TADAWUL_DAILY_SYNC_ON_STARTUP=false
TADAWUL_DAILY_QUOTE_LIMIT=250
# TickChart live ticks + Level-2 depth
TICKCHART_ENABLED=true
TICKCHART_API_KEY=
TICKCHART_REST_URL=
TICKCHART_TRADES_WS=wss://api.sahmk.sa/ws/v1/market/trades/
TICKCHART_DEPTH_WS=wss://api.sahmk.sa/ws/v1/market/depth/
TICKCHART_SYMBOLS=["2222","1120","4030","4190","7203"]
TICKCHART_PING_SECONDS=30
TICKCHART_DEPTH_LEVELS=5
TICKCHART_POLL_SECONDS=3
TICKCHART_INGEST_TOKEN=
TICKCHART_BLOCK_VALUE=500000
# Folder watch is local-only and never used on Render
TICKCHART_AUTOSYNC_ENABLED=false
TICKCHART_EXPORT_DIR=
TICKCHART_EXPORT_POLL_SECONDS=0.5
